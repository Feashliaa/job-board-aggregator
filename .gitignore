# ============================================================
# Generated data - served from the data-live branch, NOT tracked on main.
# This is the heavy daily-regenerated data that caused repo bloat.
# ============================================================
data/chunks/
data/metadata.json

# Ignore JSON files globally, except specific tracked ones below
*.json
!data/greenhouse_companies.json
!data/ashby_companies.json
!data/bamboohr_companies.json
!data/workday_companies.json
!data/lever_companies.json
!data/icims_companies.json
!data/paylocity_companies_clean.json
!data/locations.json
!data/salary/salary_lookup.json
!data/salary/shards/salary_*.json

# Keep trend history tracked on main (append-only, valuable, deltas cheaply)
!data/trends/
!data/trends/daily.jsonl

# Don't allow python files in data
data/*.py

# Ignore CSV files globally, except specific ones
/city_aggregator/*.csv
/city_aggregator/*.py
/city_aggregator/admin1CodesASCII.txt
/city_aggregator/cities500.txt